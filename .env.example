# ── Copier ce fichier en .env et remplir les valeurs ─────────
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=Tonde API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# ── Base de données ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tonde:tonde123@localhost:5432/tonde_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT — générer avec : openssl rand -hex 32 ────────────────
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP SMS (Africa's Talking) ────────────────────────────────
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=TONDE
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ── Firebase FCM ──────────────────────────────────────────────
# API HTTP v1 (l'ancienne clé serveur « legacy » est arrêtée par Google).
# FIREBASE_SERVICE_ACCOUNT_JSON : contenu JSON du compte de service OU chemin du fichier.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2

# ── Migrations ────────────────────────────────────────────────
# true uniquement en développement, false en production
CREATE_TABLES_ON_STARTUP=false

# -- Queue Engine : delais ----------------------------------------------------
ABSENT_TIMEOUT_SECONDS=180           # delai pour se presenter apres l'appel, puis ABSENT automatique
ABSENT_WARNING_SECONDS=120           # avertissement envoye avant (doit etre < ABSENT_TIMEOUT_SECONDS)
ABSENT_RETURN_WINDOW_MINUTES=30      # un client ABSENT peut revenir en file pendant ce delai
WAITING_TICKET_TTL_HOURS=12          # un ticket jamais appele est clos apres ce delai
SERVING_TICKET_TTL_HOURS=6           # ticket SERVING oublie par l'agent -> INCOMPLETE
INCOMPLETE_TICKET_TTL_HOURS=24       # ticket INCOMPLETE non resolu -> clos

# -- Scheduler (taches de fond, sans Celery) ----------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=5
MAINTENANCE_INTERVAL_SECONDS=60

# -- Sync hors-ligne / QR / exports -------------------------------------------
SYNC_WINDOW_DAYS=7
SYNC_MAX_ACTIONS=50
QR_TICKET_TTL_HOURS=24
EXPORT_MAX_ROWS=100000
EXPORT_BATCH_SIZE=1000

# -- PRODUCTION : l'application REFUSE de demarrer si --------------------------
#   JWT_SECRET_KEY < 32 caracteres ou valeur par defaut, DEBUG=true,
#   CREATE_TABLES_ON_STARTUP=true. En production : ENVIRONMENT=production
#   (desactive aussi /docs et /redoc).